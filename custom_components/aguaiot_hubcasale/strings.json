{
  "config": {
    "flow_title": "Micronova Agua IOT",
    "step": {
      "user": {
        "description": "[%key:common::config_flow::description%]",
        "data": {
          "api_url": "[%key:common::config_flow::data::api_url%]",
          "login_api_url": "[%key:common::config_flow::data::login_api_url%]",
          "customer_code": "[%key:common::config_flow::data::customer_code%]",
          "brand_id": "[%key:common::config_flow::data::brand_id%]",
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "unauthorized": "[%key:common::config_flow::error::unauthorized%]",
      "connection_error": "[%key:common::config_flow::error::connection_error%]",
      "unknown_error": "[%key:common::config_flow::error::unknown_error%]"
    },
    "abort": {
      "device_already_configured": "[%key:common::config_flow::abort::device_already_configured%]"
    }
  },
  "services": {
    "sync_clock": {
      "name": "Synchronize Stove Clock",
      "description": "Synchronize stove time and date with the current Home Assistant time and date."
    },
    "set_chrono_program": {
      "name": "Set chrono program",
      "description": "Program one of the weekly chrono programs of the stove/boiler in a single request. Only the fields you fill in are changed. The days you select are enabled, all the others are disabled. Times are rounded down to 10 minutes.",
      "fields": {
        "program": {
          "name": "Program",
          "description": "Chrono program number (1-4)."
        },
        "start": {
          "name": "Start time",
          "description": "Time the program switches the appliance on."
        },
        "stop": {
          "name": "Stop time",
          "description": "Time the program switches the appliance off."
        },
        "days": {
          "name": "Days",
          "description": "Weekdays on which the program is active."
        },
        "water_temperature": {
          "name": "Water temperature",
          "description": "Water set temperature used by the program."
        },
        "boiler_temperature": {
          "name": "Boiler temperature",
          "description": "Boiler (DHW tank) set temperature used by the program."
        },
        "acs": {
          "name": "DHW",
          "description": "Enable domestic hot water production during the program."
        },
        "weekly_enabled": {
          "name": "Weekly chrono enabled",
          "description": "Switch the weekly chrono function on or off for the whole device."
        }
      }
    }
  },
  "options": {
    "step": {
      "user": {
        "title": "Micronova Agua IOT options",
        "description": "Select `Bluetooth (auto-detect)` to let Home Assistant auto-detect and validate a nearby Micronova BLE module when you submit the form (experimental).",
        "data": {
          "http_timeout": "Timeout for API calls (seconds).",
          "buffer_read_timeout": "Timeout for stove buffer reading (seconds).",
